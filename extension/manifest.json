{
  "manifest_version": 3,
  "name": "ChatGPT ↔ Codex 本地桥接",
  "version": "0.7.0",
  "description": "仅在绑定的 ChatGPT 标签页和本机 Codex CLI 之间转发指令卡片与最终报告。",
  "permissions": ["storage", "activeTab", "scripting", "alarms"],
  "host_permissions": ["http://127.0.0.1/*", "https://chatgpt.com/*", "https://chat.openai.com/*"],
  "background": {"service_worker": "background.js"},
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"],
      "js": ["optimizer-main.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"],
      "js": ["optimizer-bridge.js"],
      "run_at": "document_start"
    }
  ],
  "action": {"default_popup": "popup.html"}
}
